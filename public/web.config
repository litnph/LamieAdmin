<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!--
      BrowserRouter routes only exist in the React application. When IIS cannot
      find a matching static file, execute the SPA entry point so React Router
      can resolve the requested URL. This uses built-in IIS configuration and
      does not require the optional URL Rewrite module.
    -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
